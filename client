      br: { bottom: "16px", right: "16px", top: "auto", left: "auto" },
      bl: { bottom: "16px", left: "16px", top: "auto", right: "auto" }
    };

    function applyCorner(corner) {
      const pos = CORNER_OFFSETS[corner] || CORNER_OFFSETS.tr;
      Object.assign(root.style, pos);
      root.style.transformOrigin = corner.includes("r") ? "top right" : "top left";
      prefs.corner = corner;
      root.querySelectorAll(".tsa-corner").forEach(el => {
        el.classList.toggle("active", el.dataset.corner === corner);
      });
      saveUiPrefs(prefs);
    }

    function applyFreePosition(top, left) {
      root.style.top = top + "px";
      root.style.left = left + "px";
      root.style.right = "auto";
      root.style.bottom = "auto";
      prefs.freePos = { top, left };
      saveUiPrefs(prefs);
    }

    const navItems = Array.from(root.querySelectorAll(".tsa-navitem"));
    const panes = Array.from(root.querySelectorAll(".tsa-pane"));
    const full = root.querySelector("#tsa-full");
    const names = root.querySelector("#tsa-names");
    const showMarkersBtn = root.querySelector("#tsa-showmarkers");
    const fov = root.querySelector("#tsa-fov");
    const status = root.querySelector("#tsa-status");
    const scaleInput = root.querySelector("#tsa-scale");
    const accentPicker = root.querySelector("#tsa-accent-picker");
    const swatchWrap = root.querySelector("#tsa-swatches");
    const themeSelect = root.querySelector("#tsa-theme");
    const langSelect = root.querySelector("#tsa-lang");
    const markerShapeSel = root.querySelector("#tsa-marker-shape");
    const markerSizeInput = root.querySelector("#tsa-marker-size");
    const markerColorModeSel = root.querySelector("#tsa-marker-colormode");
    const markerColorRow = root.querySelector("#tsa-marker-color-row");
    const markerColorInput = root.querySelector("#tsa-marker-color");
    const markerOutlineBtn = root.querySelector("#tsa-marker-outline");
    const nameSizeInput = root.querySelector("#tsa-name-size");
    const nameColorInput = root.querySelector("#tsa-name-color");
    const nameOutlineColorInput = root.querySelector("#tsa-name-outline-color");
    const nameOutlineWidthInput = root.querySelector("#tsa-name-outline-width");
    const crosshairBtn = root.querySelector("#tsa-crosshair");
    const highlightSelect = root.querySelector("#tsa-highlight-select");
    const highlightColorInput = root.querySelector("#tsa-highlight-color");
    const exportBtn = root.querySelector("#tsa-export");
    const importBtn = root.querySelector("#tsa-import");
    const importFile = root.querySelector("#tsa-import-file");
    const resetBtn = root.querySelector("#tsa-reset");

    Object.keys(LANG_NAMES).forEach(code => {
