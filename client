                display: block;
                width: 100%;
                text-align: left;
                background: #142433;
                border: 1px solid #2b4d63;
                color: #cfe8f5;
                border-radius: 6px;
                padding: 8px 10px;
                cursor: pointer;
                font-size: 12.5px;
                margin-bottom: 6px;
            }
            #sb-gf-panel .sb-font-btn:hover, #sb-gf-panel .sb-action-btn:hover { background: #1b2f42; }
            #sb-gf-panel .sb-font-btn.active {
                background: #24405a;
                border-color: #6fc3e8;
                font-weight: 700;
            }
            #sb-gf-panel .sb-footer {
                display: flex;
                gap: 8px;
                margin-top: 14px;
            }
            #sb-gf-panel .sb-btn {
                flex: 1;
                background: #1b2f42;
                border: 1px solid #2b4d63;
                color: #cfe8f5;
                border-radius: 6px;
                padding: 7px 0;
                cursor: pointer;
                font-size: 12px;
                font-weight: 600;
            }
            #sb-gf-panel .sb-btn:hover { background: #24405a; }
        `;
        document.head.appendChild(style);

        const toggle = document.createElement('div');
        toggle.id = 'sb-gf-toggle';
        toggle.innerHTML = `<span>&#127912;</span><span>Theme</span>`;
        document.body.appendChild(toggle);

        const panel = document.createElement('div');
        panel.id = 'sb-gf-panel';
        panel.classList.add('hidden');
        document.body.appendChild(panel);

        renderPanel(panel);

        toggle.addEventListener('click', () => {
            panelOpen = !panelOpen;
            panel.classList.toggle('hidden', !panelOpen);
        });
    }

    function renderPanel(panel) {
        panel.innerHTML = '';

        // --- Section couleurs / gradient ---
        const gradTitle = document.createElement('h4');
        gradTitle.textContent = 'Theme degrade';
        panel.appendChild(gradTitle);

        const row1 = document.createElement('div');
        row1.className = 'sb-color-row';
        row1.innerHTML = `<span>Couleur 1</span>`;
        const input1 = document.createElement('input');
        input1.type = 'color';
        input1.value = gradientSettings.primary;
        input1.addEventListener('input', (e) => { gradientSettings.primary = e.target.value; });
        row1.appendChild(input1);
        panel.appendChild(row1);

        const row2 = document.createElement('div');
        row2.className = 'sb-color-row';
        row2.innerHTML = `<span>Couleur 2</span>`;
        const input2 = document.createElement('input');
        input2.type = 'color';
        input2.value = gradientSettings.secondary;
        input2.addEventListener('input', (e) => { gradientSettings.secondary = e.target.value; });
        row2.appendChild(input2);
        panel.appendChild(row2);

        const applyBtn = document.createElement('button');
        applyBtn.className = 'sb-action-btn';
        applyBtn.textContent = '✔ Appliquer le degrade';
        applyBtn.addEventListener('click', applyGradientTheme);
        panel.appendChild(applyBtn);

        const resetBtn = document.createElement('button');
        resetBtn.className = 'sb-action-btn';
        resetBtn.textContent = '↺ Reinitialiser le theme';
        resetBtn.addEventListener('click', resetGradientTheme);
        panel.appendChild(resetBtn);

        // --- Section polices ---
        const fontTitle = document.createElement('h4');
        fontTitle.textContent = 'Police d\'ecriture';
        panel.appendChild(fontTitle);

        FONTS.forEach((f) => {
            const btn = document.createElement('button');
            btn.className = 'sb-font-btn' + (activeFont === f.id ? ' active' : '');
            btn.textContent = f.label;
            btn.addEventListener('click', () => {
                applyFont(f.id);
                panel.querySelectorAll('.sb-font-btn').forEach((b) => b.classList.remove('active'));
                btn.classList.add('active');
            });
            panel.appendChild(btn);
        });
    }

    // ------------------------------------------------------------------
    // Boot
    // ------------------------------------------------------------------
    function boot() {
        loadSettings();
        removeSocialLinks();
        styleFollowTools();
        replaceLogo();
        applyDarkBackground();
        buildPanel();
        // Reapplique automatiquement les reglages sauvegardes au chargement
        if (document.getElementById('sb-gf-gradient-theme') === null) {
            // On applique le gradient seulement s'il y a des reglages non-defaut
            // sauvegardes, pour ne pas forcer le theme au premier lancement.
            const hasCustomGradient = localStorage.getItem('sb_gradient_primary');
            if (hasCustomGradient) applyGradientTheme();
        }
        if (activeFont && activeFont !== 'default') applyFont(activeFont);
    }

    // Execution au plus tot possible: go() charge starblast.io en async
    // (XHR) puis fait document.write(t). On sonde le DOM toutes les 100ms
    // et on boot dès que #overlay existe, au lieu d'attendre un delai fixe.
    function bootWhenReady() {
        if (!document.querySelector('#overlay')) {
            setTimeout(bootWhenReady, 100);
            return;
        }
        try {
            boot();
        } catch (ex) {
            console.error('[Gradient/Fonts] Erreur au demarrage, nouvelle tentative dans 300ms', ex);
            setTimeout(bootWhenReady, 300);
        }
    }
    bootWhenReady();
})();
