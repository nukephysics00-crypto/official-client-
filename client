/* ========== RADAR CORE (no page rewrite) ========== */
(function () {
  "use strict";

  const W = typeof unsafeWindow !== "undefined" ? unsafeWindow : window;
  const GAMES_URL = "https://api.pixelmelt.dev/games";

  const CFG = Object.freeze({
    scanMs: 300,
    globalMs: 450,
    renderFps: 45,
    fullRadarZoom: 1,
    nameFont: "600 17px Arial, Helvetica, sans-serif",
    nameFill: "rgba(255,255,255,.98)",
    nameStroke: "rgba(0,0,0,.95)",
    nameStrokeWidth: 3,
    markerStroke: "rgba(255,255,255,.95)",
    markerWidth: 2,
    maxName: 32,
    fovFactorMin: 0.45,
    fovFactorMax: 2.25,
    fovSmooth: 0.16
  });

  const DISPLAY_STORE_KEY = "tsa203.display.v1";
  const DISPLAY_DEFAULTS = Object.freeze({
    showMarkers: true,
    markerShape: "cross",
    markerSize: 4,
    markerColorMode: "mono",
    markerColor: "#ffffff",
    markerOutline: true,
    nameFontSize: 17,
    nameFontWeight: 600,
    nameFontFamily: "Arial, Helvetica, sans-serif",
    nameColor: "#ffffff",
    nameOutlineColor: "#000000",
    nameOutlineWidth: 3,
    showCrosshair: false,
    crosshairColor: "#5b8cff",
    crosshairOpacity: 0.12,
    highlightColor: "#ffee58"
  });

  let DISPLAY = { ...DISPLAY_DEFAULTS };

  function loadDisplayPrefs() {
    try {
      const raw = localStorage.getItem(DISPLAY_STORE_KEY);
      if (!raw) return { ...DISPLAY_DEFAULTS };
      const parsed = JSON.parse(raw);
      return { ...DISPLAY_DEFAULTS, ...(parsed && typeof parsed === "object" ? parsed : {}) };
    } catch (_) {
      return { ...DISPLAY_DEFAULTS };
    }
  }

  function saveDisplayPrefs() {
    try {
      localStorage.setItem(DISPLAY_STORE_KEY, JSON.stringify(DISPLAY));
    } catch (_) {}
  }

  function hueToCss(hue) {
    const h = ((Number(hue) || 0) % 360 + 360) % 360;
    return `hsl(${h}, 85%, 62%)`;
  }

  const S = {
    root: null,
    radar: null,
    radarHooked: false,
    originalRadarUpdate2: null,
    originalRadarII11O: null,
    originalRadarZoom: null,
    radarMode: null,
    overlayCanvas: null,
    overlayTexture: null,
    overlayMesh: null,
    overlayCtx: null,
    lastRadarDraw: 0,
    interp: new Map(),
    lastInterpCleanup: 0,
    highlightedId: null,
    centerX: NaN,
    centerY: NaN,
    globalPlayers: new Map(),
    globalNames: new Map(),
    globalMapSize: 800,
    globalRoomKey: "",
    globalBusy: false,
    lastGlobalFetch: 0,
    namesEnabled: true,
    fullMapEnabled: true,
    ui: null,
    chat: null,
    camera: null,
    cameraBaseFov: null,
    fovEnabled: false,
    fovFactor: 1,
    fovTarget: 1,
    booted: false
  };

  function clamp(v, a, b) {
    return Math.max(a, Math.min(b, v));
  }

  function cleanName(v) {
    return String(v || "")
      .replace(/[\u0000-\u001F\u007F]/g, "")
      .replace(/\s+/g, " ")
      .trim()
      .slice(0, CFG.maxName);
  }

  function norm(v) {
    return cleanName(v).toUpperCase();
  }

  function getSettings() {
    try {
      return W.module?.exports?.settings || null;
    } catch (_) {
      return null;
    }
  }

  function getRoot() {
    const bag = getSettings();
    if (!bag) return null;
    try {
      return Object.values(bag).find(v => v && v.mode) || null;
    } catch (_) {
      return null;
    }
  }

  function isRadar(v) {
    try {
      return !!(
        v &&
        v.canvas &&
        v.canvas2 &&
        v.texture &&
        v.texture2 &&
        v.m1 &&
        v.m2 &&
        typeof v.II11O === "function" &&
        typeof v.IIOIl === "function" &&
        typeof v.update2 === "function"
      );
    } catch (_) {
      return false;
    }
  }

  function findRadar(root) {
    if (!root) return null;
    if (isRadar(S.radar)) return S.radar;
    const seen = new Set();
    const stack = [root];
    let count = 0;
    while (stack.length && count < 12000) {
      const value = stack.pop();
      if (!value) continue;
      const t = typeof value;
      if (t !== "object" && t !== "function") continue;
      if (seen.has(value)) continue;
      seen.add(value);
      count++;
      if (isRadar(value)) return value;
      try {
        for (const key of Object.keys(value)) {
          const child = value[key];
          if (child && (typeof child === "object" || typeof child === "function")) {
            stack.push(child);
          }
        }
      } catch (_) {}
    }
    return null;
  }

  function ownStatus(root) {
    return root?.IO1OO?.I0lO1?.status || null;
  }

  function getMapSize(root, radar) {
    const values = [radar?.data?.size, root?.size, S.globalMapSize, 800];
    for (const value of values) {
      const n = Number(value);
      if (Number.isFinite(n) && n > 0) {
        return n < 250 ? n * 10 : n;
      }
    }
    return 800;
  }

  function wrapDelta(delta, size) {
    if (!Number.isFinite(delta) || !Number.isFinite(size) || size <= 0) return delta;
    const half = size / 2;
    let d = delta;
    while (d > half) d -= size;
    while (d < -half) d += size;
    return d;
  }

  function gmGet(url) {
    return new Promise((resolve, reject) => {
      if (typeof GM_xmlhttpRequest === "function") {
        GM_xmlhttpRequest({
          method: "GET",
          url,
          timeout: 8000,
          onload(res) {
            if (res.status < 200 || res.status >= 300) {
              reject(new Error("HTTP " + res.status));
              return;
            }
            try {
              resolve(JSON.parse(res.responseText));
            } catch (e) {
              reject(e);
            }
          },
          onerror: reject,
          ontimeout() {
            reject(new Error("timeout"));
          }
        });
        return;
      }
      fetch(url, { cache: "no-store" })
        .then(r => {
          if (!r.ok) throw new Error("HTTP " + r.status);
          return r.json();
        })
        .then(resolve)
        .catch(reject);
    });
  }

  function chooseGame(games, root, radar) {
    if (!Array.isArray(games)) return null;
    const data = radar?.data || {};
    const systemId = data.systemid != null ? String(data.systemid) : "";
    const roomName = norm(data.name || "");
    const myName = norm(root?.player_name || "");
    if (systemId) {
      const byId = games.find(g => g && g.systemid != null && String(g.systemid) === systemId);
      if (byId) return byId;
    }
    if (roomName) {
      const byRoom = games.find(g => g && norm(g.name) === roomName);
      if (byRoom) return byRoom;
    }
    if (myName) {
      const byPlayer = games.find(
        g =>
          Array.isArray(g?.players) &&
          g.players.some(p => norm(p?.player_name || p?.name) === myName)
      );
      if (byPlayer) return byPlayer;
    }
    return null;
  }

  async function refreshGlobal() {
    if (S.globalBusy || Date.now() - S.lastGlobalFetch < CFG.globalMs) return;
    const root = S.root || getRoot();
    const radar = S.radar || findRadar(root);
    if (!root || !radar) return;
    S.globalBusy = true;
    try {
      const data = await gmGet(GAMES_URL);
      const games = Array.isArray(data) ? data : Object.values(data || {});
      const game = chooseGame(games, root, radar);
      S.lastGlobalFetch = Date.now();
      if (!game || !Array.isArray(game.players)) return;
      const size = Number(game.size);
      if (Number.isFinite(size) && size > 0) {
        S.globalMapSize = size < 250 ? size * 10 : size;
      }
      const roomKey = String(game.systemid ?? "") + "|" + String(game.server ?? "");
      if (S.globalRoomKey && S.globalRoomKey !== roomKey) {
        S.globalPlayers.clear();
        S.globalNames.clear();
      }
      S.globalRoomKey = roomKey;
      const players = new Map();
      const names = new Map();
      for (const p of game.players) {
        if (!p || p.id == null) continue;
        const id = String(p.id);
        const name = cleanName(p.player_name || p.name || "");
        if (name) names.set(id, name);
        const x = Number(p.x);
        const y = Number(p.y);
        if (!Number.isFinite(x) || !Number.isFinite(y)) continue;
        if (p.alive === false || p.isAlive === false) continue;
        players.set(id, { id, name, x, y, hue: Number(p.hue) || 0 });
      }
      S.globalPlayers = players;
      S.globalNames = names;
    } catch (_) {
    } finally {
      S.globalBusy = false;
    }
  }

  function getLocalPlayers(root) {
    const result = new Map();
    const names = root?.names?.names || {};
    const registry = root?.IO1OO?.lOII1?.OI0I0;
    if (!registry || typeof registry !== "object") return result;
    try {
      for (const [fallbackId, entry] of Object.entries(registry)) {
        const ship = entry?.lOOlI || entry;
        const status = ship?.status;
        if (!status || status.alive === false) continue;
        const x = Number(status.x);
        const y = Number(status.y);
        if (!Number.isFinite(x) || !Number.isFinite(y)) continue;
        const id = String(status.id ?? fallbackId);
        result.set(id, {
          id,
          name: cleanName(names[id] || S.globalNames.get(id) || ""),
          x,
          y,
          hue: Number(status.hue) || 0
        });
      }
    } catch (_) {}
    return result;
  }

  function mergedPlayers(root) {
    const result = getLocalPlayers(root);
    for (const [id, p] of S.globalPlayers) {
      if (!result.has(id)) {
        result.set(id, {
          id,
          name: cleanName(p.name || S.globalNames.get(id) || ""),
          x: p.x,
          y: p.y,
          hue: p.hue
        });
      } else if (!result.get(id).name && p.name) {
        result.get(id).name = p.name;
      }
    }
    return result;
  }

  function createOverlay(radar) {
    if (!radar || !radar.canvas2 || !radar.Il11l || !radar.m2) return false;
    try {
      if (S.overlayMesh && S.overlayMesh.parent) {
        S.overlayMesh.parent.remove(S.overlayMesh);
      }
    } catch (_) {}
    try {
      const width = radar.canvas2.width;
      const height = radar.canvas2.height;
      S.overlayCanvas = document.createElement("canvas");
      S.overlayCanvas.width = width;
      S.overlayCanvas.height = height;
      S.overlayCtx = S.overlayCanvas.getContext("2d");
      if (!S.overlayCtx) return false;
      const Texture = radar.texture2?.constructor;
      if (typeof Texture !== "function") return false;
      S.overlayTexture = new Texture(S.overlayCanvas);
      try {
        S.overlayTexture.minFilter = radar.texture2.minFilter;
        S.overlayTexture.magFilter = radar.texture2.magFilter;
        S.overlayTexture.wrapS = radar.texture2.wrapS;
        S.overlayTexture.wrapT = radar.texture2.wrapT;
      } catch (_) {}
      let mesh = null;
      if (typeof radar.m2.clone === "function") mesh = radar.m2.clone();
      if (!mesh) return false;
      if (mesh.material && typeof mesh.material.clone === "function") {
        mesh.material = mesh.material.clone();
      }
      mesh.material.map = S.overlayTexture;
      mesh.material.transparent = true;
      mesh.material.depthTest = false;
      mesh.material.depthWrite = false;
      mesh.material.opacity = 1;
      mesh.renderOrder = 10000;
      try { mesh.position.copy(radar.m2.position); } catch (_) {}
      try { mesh.rotation.copy(radar.m2.rotation); } catch (_) {}
      try { mesh.scale.copy(radar.m2.scale); } catch (_) {}
      try {
        mesh.position.z = Number(radar.m2.position.z || 0) + 0.01;
      } catch (_) {}
      radar.Il11l.add(mesh);
      S.overlayMesh = mesh;
      return true;
    } catch (_) {
      S.overlayCanvas = null;
      S.overlayTexture = null;
      S.overlayMesh = null;
      S.overlayCtx = null;
      return false;
    }
  }

  function drawMarkerShape(ctx, px, py, size) {
    const shape = DISPLAY.markerShape;
    ctx.beginPath();
    if (shape === "dot") {
      ctx.arc(px, py, size, 0, Math.PI * 2);
    } else if (shape === "diamond") {
      ctx.moveTo(px, py - size);
      ctx.lineTo(px + size, py);
      ctx.lineTo(px, py + size);
      ctx.lineTo(px - size, py);
      ctx.closePath();
    } else if (shape === "triangle") {
      ctx.moveTo(px, py - size);
      ctx.lineTo(px + size, py + size * 0.8);
      ctx.lineTo(px - size, py + size * 0.8);
      ctx.closePath();
    } else {
      ctx.moveTo(px - size, py);
      ctx.lineTo(px + size, py);
      ctx.moveTo(px, py - size);
      ctx.lineTo(px, py + size);
    }
  }

  function drawOverlay() {
    const radar = S.radar;
    const root = S.root;
    if (!radar || !root || !S.overlayCtx || !S.overlayCanvas || !S.overlayTexture) return;
    const now = performance.now();
    const minFrame = 1000 / CFG.renderFps;
    if (now - S.lastRadarDraw < minFrame) return;
    S.lastRadarDraw = now;
    const me = ownStatus(root);
    if (!me) return;
    const radarWrapper = root?.display?.screen?.Il10l?.I1II0;
    const shipsRadar = radarWrapper?.O0011;
    const posmap = shipsRadar?.posmap;
    if (!posmap || !shipsRadar) return;
    let myX = NaN;
    let myY = NaN;
    try {
      myX = Number(shipsRadar.material.uniforms.mypos.value.x);
      myY = Number(shipsRadar.material.uniforms.mypos.value.y);
    } catch (_) {}
    if (!Number.isFinite(myX) || !Number.isFinite(myY)) {
      const scale = Number(root?.OI0ll) || 400;
      myX = Number(me.x) / scale;
      myY = Number(me.y) / scale;
    }
    const currentIteration = Number(shipsRadar.iteration);
    const expectedIteration = Number.isFinite(currentIteration) ? currentIteration - 1 : null;
    const zoom = S.fullMapEnabled ? CFG.fullRadarZoom : Number(S.originalRadarZoom) || 1;
    const width = S.overlayCanvas.width;
    const height = S.overlayCanvas.height;
    const ctx = S.overlayCtx;
    const nativeNames = root?.names?.names || {};
    const localPlayers = getLocalPlayers(root);
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.clearRect(0, 0, width, height);
    ctx.save();
    if (DISPLAY.showCrosshair) {
      const cx = width / 2;
      const cy = height / 2;
      ctx.strokeStyle = DISPLAY.crosshairColor;
      ctx.globalAlpha = DISPLAY.crosshairOpacity;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(cx, 0);
      ctx.lineTo(cx, height);
      ctx.moveTo(0, cy);
      ctx.lineTo(width, cy);
      ctx.stroke();
      ctx.globalAlpha = 1;
    }
    function nativeWrap(v) {
      let x = Number(v);
      while (x > 1) x -= 2;
      while (x < -1) x += 2;
      return x;
    }
    for (const [id, nativePos] of Object.entries(posmap)) {
      const numericId = Number(id);
      if (!Number.isFinite(numericId) || numericId >= 1000) continue;
      if (String(id) === String(me.id)) continue;
      if (!nativePos) continue;
      const nx = Number(nativePos.x);
      const ny = Number(nativePos.y);
      if (!Number.isFinite(nx) || !Number.isFinite(ny)) continue;
      if (
        expectedIteration !== null &&
        Number.isFinite(Number(nativePos.iteration)) &&
        Number(nativePos.iteration) !== expectedIteration
      ) {
        continue;
      }
      let rec = S.interp.get(String(id));
      if (!rec) {
        rec = { rawX: nx, rawY: ny, px: nx, py: ny, tx: nx, ty: ny, t0: now, dur: 1 };
        S.interp.set(String(id), rec);
      } else if (rec.rawX !== nx || rec.rawY !== ny) {
        const wrappedDX = nativeWrap(nx - rec.rawX);
        const wrappedDY = nativeWrap(ny - rec.rawY);
        const gap = clamp(now - rec.t0, 16, 2000);
        rec.px = rec.tx;
        rec.py = rec.ty;
        rec.tx = rec.tx + wrappedDX;
        rec.ty = rec.ty + wrappedDY;
        rec.rawX = nx;
        rec.rawY = ny;
        rec.t0 = now;
        rec.dur = gap;
      }
      const frac = clamp((now - rec.t0) / rec.dur, 0, 1);
      const eased = frac * frac * (3 - 2 * frac);
      const useNx = rec.px + (rec.tx - rec.px) * eased;
      const useNy = rec.py + (rec.ty - rec.py) * eased;
      const dx = nativeWrap(useNx - myX);
      const dy = nativeWrap(useNy - myY);
      const px = (0.5 + (dx * zoom) / 2) * width;
      const py = (0.5 - (dy * zoom) / 2) * height;
      if (!Number.isFinite(px) || !Number.isFinite(py)) continue;
      if (px < -100 || px > width + 100 || py < -100 || py > height + 100) continue;
      const isHighlighted = S.highlightedId != null && String(id) === String(S.highlightedId);
      if (DISPLAY.showMarkers) {
        const local0 = localPlayers.get(String(id));
        const markerColor = isHighlighted
          ? DISPLAY.highlightColor
          : DISPLAY.markerColorMode === "byHue"
            ? hueToCss(local0?.hue)
            : DISPLAY.markerColor;
        const markerSize = isHighlighted ? DISPLAY.markerSize + 2 : DISPLAY.markerSize;
        if (DISPLAY.markerOutline || isHighlighted) {
          drawMarkerShape(ctx, px, py, markerSize + 1.5);
          ctx.lineWidth = CFG.markerWidth + 2;
          ctx.strokeStyle = "rgba(0,0,0,.65)";
          ctx.stroke();
        }
        if (isHighlighted) {
          ctx.beginPath();
          ctx.arc(px, py, markerSize + 6, 0, Math.PI * 2);
          ctx.lineWidth = 1.5;
          ctx.strokeStyle = markerColor;
          ctx.globalAlpha = 0.85;
          ctx.stroke();
          ctx.globalAlpha = 1;
        }
        drawMarkerShape(ctx, px, py, markerSize);
        ctx.lineWidth = CFG.markerWidth;
        ctx.strokeStyle = markerColor;
        ctx.stroke();
        if (DISPLAY.markerShape === "dot" || DISPLAY.markerShape === "diamond" || DISPLAY.markerShape === "triangle") {
          ctx.fillStyle = markerColor;
          ctx.globalAlpha = 0.9;
          ctx.fill();
          ctx.globalAlpha = 1;
        }
      }
      if (!S.namesEnabled) continue;
      const local = localPlayers.get(String(id));
      const name = cleanName(nativeNames[id] || local?.name || S.globalNames.get(String(id)) || "");
      if (!name) continue;
      ctx.font = `${DISPLAY.nameFontWeight} ${DISPLAY.nameFontSize}px ${DISPLAY.nameFontFamily}`;
      ctx.textAlign = "center";
      ctx.textBaseline = "bottom";
      ctx.lineWidth = DISPLAY.nameOutlineWidth;
      ctx.strokeStyle = DISPLAY.nameOutlineColor;
      ctx.fillStyle = isHighlighted ? DISPLAY.highlightColor : DISPLAY.nameColor;
      const textY = py - 9;
      ctx.strokeText(name, px, textY);
      ctx.fillText(name, px, textY);
    }
    ctx.restore();
    if (now - S.lastInterpCleanup > 5000) {
      S.lastInterpCleanup = now;
      const liveIds = new Set(Object.keys(posmap));
      for (const key of S.interp.keys()) {
        if (!liveIds.has(key)) S.interp.delete(key);
      }
    }
    try {
      S.overlayTexture.needsUpdate = true;
    } catch (_) {}
  }

  function setRadarZoomMode() {
    const radar = S.radar;
    if (!radar || !radar.texture?.repeat) return;
    const mode = radar.Ol111?.mode;
    if (!mode) return;
    if (S.fullMapEnabled) {
      try { mode.radar_zoom = CFG.fullRadarZoom; } catch (_) {}
      try { radar.texture.repeat.set(1, 1); } catch (_) {}
    } else if (Number.isFinite(S.originalRadarZoom)) {
      try { mode.radar_zoom = S.originalRadarZoom; } catch (_) {}
      try {
        radar.texture.repeat.set(1 / S.originalRadarZoom, 1 / S.originalRadarZoom);
      } catch (_) {}
    }
  }

  function reapplyNativeCenter() {
    if (!S.radar || typeof S.originalRadarII11O !== "function") return;
    if (!Number.isFinite(S.centerX) || !Number.isFinite(S.centerY)) return;
    try {
      S.originalRadarII11O.call(S.radar, S.centerX, S.centerY);
    } catch (_) {}
  }

  function hookRadar(radar) {
    if (!radar || radar.__tsa203hooked) return;
    radar.__tsa203hooked = true;
    S.radar = radar;
    S.radarMode = radar.Ol111?.mode || null;
    S.originalRadarZoom = Number(S.radarMode?.radar_zoom);
    if (!Number.isFinite(S.originalRadarZoom) || S.originalRadarZoom <= 0) {
      S.originalRadarZoom = 1;
    }
    S.originalRadarUpdate2 = radar.update2;
    S.originalRadarII11O = radar.II11O;
    radar.update2 = function (...args) {
      const result = S.originalRadarUpdate2.apply(this, args);
      try {
        setRadarZoomMode();
        if (!S.overlayMesh) createOverlay(this);
        drawOverlay();
      } catch (_) {}
      return result;
    };
    radar.II11O = function (x, y, ...args) {
      if (Number.isFinite(Number(x))) S.centerX = Number(x);
      if (Number.isFinite(Number(y))) S.centerY = Number(y);
      setRadarZoomMode();
      const result = S.originalRadarII11O.call(this, x, y, ...args);
      try {
        if (!S.overlayMesh) createOverlay(this);
        drawOverlay();
      } catch (_) {}
      return result;
    };
    try {
      createOverlay(radar);
      setRadarZoomMode();
    } catch (_) {}
  }

  function ensureRadar() {
    const root = getRoot();
    if (!root) return;
    S.root = root;
    const radar = findRadar(root);
    if (!radar) return;
    if (radar !== S.radar) {
      S.radar = null;
      S.overlayCanvas = null;
      S.overlayTexture = null;
      S.overlayMesh = null;
      S.overlayCtx = null;
      S.radarMode = null;
      S.originalRadarZoom = null;
      S.centerX = NaN;
      S.centerY = NaN;
      hookRadar(radar);
    }
    setRadarZoomMode();
  }

  function isPerspectiveCamera(value) {
    try {
      return (
        value?.isPerspectiveCamera === true &&
        Number.isFinite(Number(value.fov)) &&
        typeof value.updateProjectionMatrix === "function"
      );
    } catch (_) {
      return false;
    }
  }

  function cameraScore(value, root) {
    if (!isPerspectiveCamera(value)) return -Infinity;
    let score = 0;
    const fov = Number(value.fov);
    const aspect = Number(value.aspect);
    const z = Number(value.position?.z);
    if (fov >= 20 && fov <= 100) score += 30;
    if (aspect > 1.1 && aspect < 3) score += 35;
    if (z > 2 && z < 100000) score += 20;
    try {
      if (root?.camera === value) score += 100;
      if (root?.screen?.camera === value) score += 120;
    } catch (_) {}
    return score;
  }

  function findCamera(root) {
    const seeds = [root, W.module?.exports, W.game, W.scene, W.renderer, W.camera].filter(Boolean);
    const seen = new Set();
    const stack = [...seeds];
    let count = 0;
    let best = null;
    let bestScore = -Infinity;
    while (stack.length && count < 18000) {
      const value = stack.pop();
