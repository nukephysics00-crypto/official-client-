    function applyLocale() {
      root.querySelectorAll("[data-i18n]").forEach(el => {
        el.textContent = t(lang, el.dataset.i18n);
      });
      launcher.title = t(lang, "launcher_title");
      langSelect.value = lang;
      refreshPlayerList();
      updateStatus();
    }

    function setLang(code) {
      lang = I18N[code] ? code : "fr";
      prefs.lang = lang;
      saveUiPrefs(prefs);
      applyLocale();
    }

    function setOpen(open) {
      prefs.panelOpen = open;
      root.classList.toggle("open", open);
      saveUiPrefs(prefs);
    }

    function setTab(tab) {
      prefs.activeTab = tab;
      navItems.forEach(el => el.classList.toggle("active", el.dataset.tab === tab));
      panes.forEach(el => el.classList.toggle("active", el.dataset.pane === tab));
      saveUiPrefs(prefs);
    }

    function applyAccent(hex) {
      prefs.accent = hex;
      root.style.setProperty("--tsa-accent", hex);
      launcher.style.setProperty("--tsa-accent", hex);
      accentPicker.value = hex;
      saveUiPrefs(prefs);
    }

    function applyScale(val) {
      prefs.scale = clamp(Number(val) || 1, 0.85, 1.25);
      root.style.setProperty("--tsa-scale", String(prefs.scale));
      scaleInput.value = String(prefs.scale);
      saveUiPrefs(prefs);
    }

    function applyTheme(theme) {
      prefs.theme = theme === "light" ? "light" : "dark";
      root.classList.toggle("theme-light", prefs.theme === "light");
      themeSelect.value = prefs.theme;
      saveUiPrefs(prefs);
    }

    const sync = () => {
      full.classList.toggle("on", S.fullMapEnabled);
      names.classList.toggle("on", S.namesEnabled);
      showMarkersBtn.classList.toggle("on", DISPLAY.showMarkers);
      fov.classList.toggle("on", S.fovEnabled);
    };

    function refreshDisplayInputs() {
      markerShapeSel.value = DISPLAY.markerShape;
      markerSizeInput.value = String(DISPLAY.markerSize);
      markerColorModeSel.value = DISPLAY.markerColorMode;
      markerColorInput.value = DISPLAY.markerColor;
      markerColorRow.style.display = DISPLAY.markerColorMode === "mono" ? "flex" : "none";
      markerOutlineBtn.classList.toggle("on", DISPLAY.markerOutline);
      nameSizeInput.value = String(DISPLAY.nameFontSize);
      nameColorInput.value = DISPLAY.nameColor;
      nameOutlineColorInput.value = DISPLAY.nameOutlineColor;
      nameOutlineWidthInput.value = String(DISPLAY.nameOutlineWidth);
      crosshairBtn.classList.toggle("on", DISPLAY.showCrosshair);
      showMarkersBtn.classList.toggle("on", DISPLAY.showMarkers);
      highlightColorInput.value = DISPLAY.highlightColor;
    }

    function setDisplay(patch) {
      DISPLAY = { ...DISPLAY, ...patch };
      saveDisplayPrefs();
      refreshDisplayInputs();
    }

    function refreshPlayerList() {
      if (!S.root) return;
      let players;
      try {
        players = mergedPlayers(S.root);
      } catch (_) {
        return;
      }
      const currentValue = highlightSelect.value;
      const stillPresent = currentValue && players.has(currentValue);
      highlightSelect.innerHTML = "";
      const noneOpt = document.createElement("option");
      noneOpt.value = "";
      noneOpt.textContent = t(lang, "highlight_none");
      highlightSelect.appendChild(noneOpt);
      const sorted = Array.from(players.values())
        .filter(p => p && p.name)
        .sort((a, b) => a.name.localeCompare(b.name));
      for (const p of sorted) {
        const opt = document.createElement("option");
        opt.value = String(p.id);
        opt.textContent = p.name;
        highlightSelect.appendChild(opt);
      }
      if (stillPresent) {
        highlightSelect.value = currentValue;
      } else if (S.highlightedId) {
        S.highlightedId = null;
        highlightSelect.value = "";
      }
    }

    launcher.onclick = () => setOpen(!root.classList.contains("open"));
    navItems.forEach(el => {
      el.onclick = () => setTab(el.dataset.tab);
    });
    full.onclick = () => {
      S.fullMapEnabled = !S.fullMapEnabled;
      setRadarZoomMode();
      reapplyNativeCenter();
      drawOverlay();
      sync();
    };
    names.onclick = () => {
      S.namesEnabled = !S.namesEnabled;
      drawOverlay();
      sync();
    };
    showMarkersBtn.onclick = () => {
      setDisplay({ showMarkers: !DISPLAY.showMarkers });
      drawOverlay();
    };
    fov.onclick = () => {
      S.fovEnabled = !S.fovEnabled;
      if (!S.fovEnabled) {
        S.fovTarget = 1;
        S.fovFactor = 1;
      }
      sync();
    };
    markerShapeSel.onchange = () => setDisplay({ markerShape: markerShapeSel.value });
    markerSizeInput.oninput = () => setDisplay({ markerSize: Number(markerSizeInput.value) });
    markerColorModeSel.onchange = () => setDisplay({ markerColorMode: markerColorModeSel.value });
    markerColorInput.oninput = () => setDisplay({ markerColor: markerColorInput.value });
    markerOutlineBtn.onclick = () => setDisplay({ markerOutline: !DISPLAY.markerOutline });
    nameSizeInput.oninput = () => setDisplay({ nameFontSize: Number(nameSizeInput.value) });
    nameColorInput.oninput = () => setDisplay({ nameColor: nameColorInput.value });
    nameOutlineColorInput.oninput = () => setDisplay({ nameOutlineColor: nameOutlineColorInput.value });
    nameOutlineWidthInput.oninput = () => setDisplay({ nameOutlineWidth: Number(nameOutlineWidthInput.value) });
    crosshairBtn.onclick = () => setDisplay({ showCrosshair: !DISPLAY.showCrosshair });
    highlightSelect.onchange = () => {
      S.highlightedId = highlightSelect.value || null;
    };
    highlightColorInput.oninput = () => setDisplay({ highlightColor: highlightColorInput.value });

    ["#5b8cff", "#ff6a4d", "#2ee6a6", "#c86bff", "#ffcc4d"].forEach(hex => {
      const sw = document.createElement("div");
      sw.className = "tsa-swatch";
      sw.style.background = hex;
      sw.onclick = () => applyAccent(hex);
      swatchWrap.appendChild(sw);
    });
    accentPicker.oninput = () => applyAccent(accentPicker.value);
    scaleInput.oninput = () => applyScale(scaleInput.value);
    themeSelect.onchange = () => applyTheme(themeSelect.value);
    langSelect.onchange = () => setLang(langSelect.value);
    root.querySelectorAll(".tsa-corner").forEach(btn => {
      btn.onclick = () => applyCorner(btn.dataset.corner);
    });

    exportBtn.onclick = () => {
      const bundle = { ui: prefs, display: DISPLAY, exportedAt: new Date().toISOString(), version: "2.0.3" };
      const blob = new Blob([JSON.stringify(bundle, null, 2)], { type: "application/json" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "radar-core-settings.json";
      a.click();
      URL.revokeObjectURL(url);
    };
    importBtn.onclick = () => importFile.click();
    importFile.onchange = () => {
      const file = importFile.files && importFile.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        try {
          const parsed = JSON.parse(String(reader.result || "{}"));
          if (parsed.display && typeof parsed.display === "object") {
            DISPLAY = { ...DISPLAY_DEFAULTS, ...parsed.display };
            saveDisplayPrefs();
            refreshDisplayInputs();
          }
          if (parsed.ui && typeof parsed.ui === "object") {
            Object.assign(prefs, UI_DEFAULTS, parsed.ui);
            saveUiPrefs(prefs);
            applyAccent(prefs.accent);
            applyScale(prefs.scale);
            applyTheme(prefs.theme || "dark");
            applyCorner(prefs.corner || "tr");
            setLang(prefs.lang || "fr");
          }
          sync();
        } catch (_) {}
      };
      reader.readAsText(file);
      importFile.value = "";
    };
    resetBtn.onclick = () => {
      DISPLAY = { ...DISPLAY_DEFAULTS };
      saveDisplayPrefs();
      refreshDisplayInputs();
      Object.assign(prefs, UI_DEFAULTS);
      saveUiPrefs(prefs);
      applyAccent(prefs.accent);
      applyScale(prefs.scale);
      applyTheme("dark");
      applyCorner("tr");
      setLang("fr");
      sync();
    };

    const dragHandle = root.querySelector("#tsa-drag-handle");
    let dragging = false;
    let dragDX = 0;
    let dragDY = 0;
    dragHandle.addEventListener("mousedown", e => {
      dragging = true;
      const rect = root.getBoundingClientRect();
      dragDX = e.clientX - rect.left;
      dragDY = e.clientY - rect.top;
      e.preventDefault();
    });
    W.addEventListener("mousemove", e => {
      if (!dragging) return;
      const top = clamp(e.clientY - dragDY, 4, window.innerHeight - 40);
      const left = clamp(e.clientX - dragDX, 4, window.innerWidth - 40);
      applyFreePosition(top, left);
    });
    W.addEventListener("mouseup", () => {
      dragging = false;
    });
    W.addEventListener(
      "keydown",
      e => {
        if (!e.altKey || e.repeat || e.code !== "KeyR") return;
        if (e.target && /^(INPUT|TEXTAREA|SELECT)$/i.test(e.target.tagName)) return;
        e.preventDefault();
        setOpen(!root.classList.contains("open"));
      },
      true
    );

    setTab(prefs.activeTab && panes.some(p => p.dataset.pane === prefs.activeTab) ? prefs.activeTab : "radar");
    applyAccent(prefs.accent);
    applyScale(prefs.scale);
    applyTheme(prefs.theme || "dark");
    applyLocale();
    if (prefs.freePos && Number.isFinite(prefs.freePos.top) && Number.isFinite(prefs.freePos.left)) {
      applyFreePosition(prefs.freePos.top, prefs.freePos.left);
    } else {
      applyCorner(prefs.corner || "tr");
    }
    refreshDisplayInputs();
    sync();

    S.ui = {
      status,
      sync,
      getLang: () => lang,
      refreshPlayerList,
      setStatusText(text) {
        status.textContent = text;
      }
    };
  }

  function updateStatus() {
    if (!S.ui) return;
    const lang = S.ui.getLang ? S.ui.getLang() : "fr";
    if (!S.root || !S.radar) {
      S.ui.status.textContent = t(lang, "status_waiting");
      return;
    }
    const count = mergedPlayers(S.root).size;
    const radarState = S.fullMapEnabled ? t(lang, "status_fullmap") : t(lang, "status_normal");
    const overlayState = S.overlayMesh ? t(lang, "status_overlay_ok") : t(lang, "status_overlay_pending");
    const cameraState = S.camera ? t(lang, "status_camera_ok") : t(lang, "status_camera_pending");
    const playersLabel = t(lang, "status_players").replace("{n}", String(count));
    S.ui.status.textContent = `${playersLabel} · ${radarState} · ${overlayState} · ${cameraState}`;
  }

  function mainLoop() {
    try {
      ensureRadar();
      drawOverlay();
      updateStatus();
    } catch (_) {}
    requestAnimationFrame(mainLoop);
  }

  function start() {
    if (S.booted) return;
    S.booted = true;
    DISPLAY = loadDisplayPrefs();
    W.__tsaDebug = {
      getRadar: () => S.radar,
      getRoot: () => S.root,
      getState: () => S
    };
    console.log("[Radar Core] booted (fusion, no page rewrite)");
    createUI();
    startFovInput();
    requestAnimationFrame(animateFov);
    requestAnimationFrame(mainLoop);
    setInterval(ensureRadar, CFG.scanMs);
    setInterval(refreshGlobal, 100);
    setInterval(scanCamera, 1000);
    setInterval(() => {
      if (S.ui?.refreshPlayerList) S.ui.refreshPlayerList();
    }, 1000);
    scanCamera();
  }

  window.__startRadarCore = start;
})();

