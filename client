  gemLbl.style.cssText = "color:#ccc;font-size:9px;font-family:monospace;flex:1;";
  gemLbl.textContent = "Gem colors";
  const c1 = document.createElement("input");
  c1.type = "color";
  c1.value = (() => { try { return JSON.parse(localStorage.getItem("gem1")) || "#8a2be2"; } catch(_) { return "#8a2be2"; } })();
  c1.style.cssText = "width:22px;height:14px;border:none;background:none;cursor:pointer;padding:0;";
  c1.oninput = e => localStorage.setItem("gem1", JSON.stringify(e.target.value));
  const c2 = document.createElement("input");
  c2.type = "color";
  c2.value = (() => { try { return JSON.parse(localStorage.getItem("gem2")) || "#9370db"; } catch(_) { return "#9370db"; } })();
  c2.style.cssText = "width:22px;height:14px;border:none;background:none;cursor:pointer;padding:0;";
  c2.oninput = e => localStorage.setItem("gem2", JSON.stringify(e.target.value));
  gemRow.appendChild(gemLbl);
  gemRow.appendChild(c1);
  gemRow.appendChild(c2);
  panel.appendChild(gemRow);

  // champs URL pour les sons custom
  const soundFields = [
    { label: "URL son Hit",       storageKey: "hitSoundUrl",      fallback: "DEFAULT_HIT_SOUND" },
    { label: "URL son Kill",      storageKey: "killSoundUrl",     fallback: "DEFAULT_KILL_SOUND" },
    { label: "URL son Level Up",  storageKey: "levelUpSoundUrl",  fallback: "DEFAULT_LEVELUP_SOUND" },
  ];

  soundFields.forEach(({ label, storageKey, fallback }) => {
    const wrap = document.createElement("div");
    wrap.style.cssText = "display:flex;flex-direction:column;gap:2px;margin-top:4px;";

    const lbl = document.createElement("div");
    lbl.style.cssText = "color:#aaa;font-size:8px;font-family:monospace;";
    lbl.textContent = label + " (son par défaut actif si vide)";

    const input = document.createElement("input");
    input.type = "text";
    input.placeholder = "laisser vide = son par défaut intégré";
    input.value = localStorage.getItem(storageKey) || "";
    input.style.cssText = "background:#1a1a1a;border:1px solid #444;color:#ddd;font-size:8px;font-family:monospace;padding:3px 5px;border-radius:4px;width:100%;box-sizing:border-box;";

    let saveTimeout;
    input.oninput = () => {
      clearTimeout(saveTimeout);
      saveTimeout = setTimeout(() => {
        if (input.value.trim()) {
          localStorage.setItem(storageKey, input.value.trim());
        } else {
          localStorage.removeItem(storageKey);
        }
        notify(label + " sauvegardé");
      }, 500);
    };

    const testBtn = document.createElement("button");
    testBtn.textContent = "Tester";
    testBtn.style.cssText = "margin-top:2px;background:#2a1a3a;color:#8a2be2;border:1px solid #8a2be2;border-radius:4px;cursor:pointer;font-family:monospace;font-size:8px;padding:3px;";
    testBtn.onclick = () => {
      const custom = localStorage.getItem(storageKey);
      const url = (custom && custom.trim()) ? custom : window[fallback];
      if (!url) { notify("Aucun son disponible"); return; }
      try {
        new Audio(url).play().catch((err) => {
          notify("Impossible de jouer ce son: " + err.name);
        });
      } catch (e) {
        notify("URL invalide");
      }
    };

    wrap.appendChild(lbl);
    wrap.appendChild(input);
    wrap.appendChild(testBtn);
    panel.appendChild(wrap);
  });

  panel.appendChild(mkDivider());
  const reloadBtn = mkBtn("↺ Recharger (appliquer tweaks)", () => location.reload());
  reloadBtn.style.fontSize = "8px";
  panel.appendChild(reloadBtn);
}


function mkBtn(label, onClick) {
  const b = document.createElement("button");
  b.textContent = label;
  b.style.cssText = "background:rgba(138,43,226,0.1);border:1px solid #8a2be280;color:#fff;font-size:9px;font-family:monospace;padding:4px 8px;border-radius:4px;cursor:pointer;text-align:left;transition:background .15s,border-color .15s;width:100%;";
  b.onmouseenter = () => { b.style.background = "rgba(138,43,226,0.3)"; b.style.borderColor = "#8a2be2"; };
  b.onmouseleave = () => { b.style.background = "rgba(138,43,226,0.1)"; b.style.borderColor = "#8a2be280"; };
  b.onclick = onClick;
  return b;
}

