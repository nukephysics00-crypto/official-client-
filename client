    toggle.onclick = () => {
      active = !active;
      localStorage.setItem(key, active ? "y" : "n");
      toggle.style.background = active ? "#8a2be2" : "#333";
      knob.style.left = active ? "19px" : "2px";
      notify(label + ": " + (active ? "ON" : "OFF"));
