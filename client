    row.appendChild(toggle);
    panel.appendChild(row);

    const sub = document.createElement("div");
    sub.textContent = info;
    sub.style.cssText = "color:#555;font-size:8px;font-family:monospace;margin-bottom:5px;padding-left:2px;";
